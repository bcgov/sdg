{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "node",
    "promise",
    "react",
    "react-perf",
    "jsx-a11y",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "ignorePatterns": ["**/test/fixtures/**", "**/routeTree.gen.ts"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-extraneous-class": ["warn", { "allowWithDecorator": true }],
    "eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off"
  },
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx}", "**/e2e/**"],
      "rules": {
        "typescript/no-non-null-assertion": "off"
      }
    },
    {
      "files": ["packages/shared-ui/src/header/element/**"],
      "rules": {
        "react/capitalized-calls": "off",
        "react/error-boundaries": "off",
        "react/exhaustive-deps": "off",
        "react/exhaustive-effect-dependencies": "off",
        "react/forward-ref-uses-ref": "off",
        "react/globals": "off",
        "react/hooks": "off",
        "react/iframe-missing-sandbox": "off",
        "react/immutability": "off",
        "react/incompatible-library": "off",
        "react/jsx-key": "off",
        "react/jsx-no-comment-textnodes": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/jsx-no-duplicate-props": "off",
        "react/jsx-no-script-url": "off",
        "react/jsx-no-undef": "off",
        "react/jsx-props-no-spread-multi": "off",
        "react/memo-dependencies": "off",
        "react/no-array-index-key": "off",
        "react/no-children-prop": "off",
        "react/no-danger-with-children": "off",
        "react/no-deriving-state-in-effects": "off",
        "react/no-did-mount-set-state": "off",
        "react/no-did-update-set-state": "off",
        "react/no-direct-mutation-state": "off",
        "react/no-find-dom-node": "off",
        "react/no-is-mounted": "off",
        "react/no-namespace": "off",
        "react/no-object-type-as-default-prop": "off",
        "react/no-render-return-value": "off",
        "react/no-string-refs": "off",
        "react/no-this-in-sfc": "off",
        "react/no-unsafe": "off",
        "react/no-unstable-nested-components": "off",
        "react/no-will-update-set-state": "off",
        "react/preserve-manual-memoization": "off",
        "react/purity": "off",
        "react/refs": "off",
        "react/set-state-in-effect": "off",
        "react/set-state-in-render": "off",
        "react/static-components": "off",
        "react/style-prop-object": "off",
        "react/use-memo": "off",
        "react/void-dom-elements-no-children": "off",
        "react/void-use-memo": "off",
        "react-perf/jsx-no-jsx-as-prop": "off",
        "react-perf/jsx-no-new-array-as-prop": "off",
        "react-perf/jsx-no-new-function-as-prop": "off",
        "react-perf/jsx-no-new-object-as-prop": "off"
      }
    }
  ]
}
