# database environment template, read by drizzle-kit.
# db:generate and db:migrate: the core login of the local postgis service in the root compose.yaml
# (dev-postgres/init-roles.sql).
# Never commit real credentials.
DATABASE_URL=postgres://core:core@localhost:5432/portal

# db:studio only (drizzle.studio.config.ts): the compose superuser (POSTGRES_USER / POSTGRES_PASSWORD), the one login
# that can read every service's schema. Local only.
STUDIO_DATABASE_URL=postgres://postgres:postgres@localhost:5432/portal
