# shared-ui production static server (packages/shared-ui/Dockerfile). Cluster-internal only: the edge
# (apps/portal-web/caddy) adds the WAF, security headers and compression, and serves this at /shared-ui/.
#   /header/v1/loader.js       the committed loader of the keyset named by HEADER_KEYSET (KTD5); 404 when unset or
#                              when no loader exists for it
#   /header/v1/manifest.json   the signed manifest, from the ConfigMap directory mounted at /manifest (KTD6); 404 until
#                              one is mounted
#   /header/v1/bundles/*       immutable, content-hashed release bundles
# Nothing serves the old unsigned /header/v1/sdg-header.js (KTD12): no such file exists, so it is a 404.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	log {
		output stdout
		format console
		level {$LOG_LEVEL:INFO}
	}

	respond /healthz 200

	# The loader and manifest keep one URL each: browsers revalidate with the ETag on every load, so a release or
	# rollback (a new manifest) reaches visitors on their next page load. Bundle names change with their content.
	header /header/v1/loader.js Cache-Control "no-cache"
	header /header/v1/manifest.json Cache-Control "no-cache"
	header /header/v1/bundles/* Cache-Control "public, max-age=31536000, immutable"

	handle /header/v1/loader.js {
		# One promoted image serves every environment; the chart picks the keyset.
		rewrite * /header/v1/loaders/{$HEADER_KEYSET}/loader.js
		root * /srv
		file_server
	}

	handle /header/v1/manifest.json {
		# A directory mount (never subPath), so a patched ConfigMap reaches running pods.
		rewrite * /manifest.json
		root * /manifest
		file_server
	}

	# No SPA fallback: a missing file is a 404.
	handle {
		root * /srv
		file_server
	}
}
