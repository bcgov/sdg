// Local stack (compose.observability.yaml): fixed targets on the compose network.
prometheus.scrape "apps" {
  targets = [
    {"__address__" = "portal-api:3000", "app" = "portal-api", "environment" = "local"},
    {"__address__" = "console-api:3000", "app" = "console-api", "environment" = "local"},
    {"__address__" = "gateway-api:3000", "app" = "gateway-api", "environment" = "local"},
    {"__address__" = "core-api:3000", "app" = "core-api", "environment" = "local"},
    {"__address__" = "caddy:3003", "app" = "edge", "environment" = "local"},
  ]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}
