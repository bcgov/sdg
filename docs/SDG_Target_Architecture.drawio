        <mxCell id="cl-h" parent="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#003366;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=24;" value="&lt;b style=&quot;font-size:24px&quot;&gt;What changed in v19&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Compared with v11 · review changes from 14 Nov 2026 (v12 to v19) · statuses and MVP flags from the CSBC Foundational Architecture library&lt;/span&gt;" vertex="1">
          <mxGeometry x="0" y="0" width="1400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cl-hb" parent="1" style="rounded=0;html=1;fillColor=#FCBA19;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="0" y="80" width="1400" height="6" as="geometry" />
        </mxCell>
        <mxCell id="cl0" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DB4D3;fontColor=#222222;align=left;verticalAlign=top;spacing=8;spacingTop=6;spacingLeft=8;" value="&lt;b style=&#39;font-size:15px;color:#003366&#39;&gt;Names to be confirmed&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:13px&#39;&gt;• SDG: name to be confirmed (title, SDG on the web channel)&lt;br&gt;• BC Services Card: new name to be confirmed (channel, sign-in and data source)&lt;/span&gt;" vertex="1">
          <mxGeometry x="40" y="116" width="1320" height="76" as="geometry" />
        </mxCell>
        <mxCell id="cl1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DB4D3;fontColor=#222222;align=left;verticalAlign=top;spacing=8;spacingTop=6;spacingLeft=8;" value="&lt;b style=&#39;font-size:15px;color:#003366&#39;&gt;Removed&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:13px&#39;&gt;• Service BC office (assisted) channel&lt;br&gt;• Address Change write-back to IAS (card text and the gold dependency line)&lt;br&gt;• Token exchange from the sign-in column, and its link from identity translation&lt;br&gt;• &amp;quot;AI never decides&amp;quot; from the SDG does not note in the experience layer&lt;br&gt;• Permission and purpose registry, policy decision service and credential trust registry from the trust column&lt;br&gt;• Business domains in authoritative data sources (business, address, property, income, program participation, credentials, partner privacy zones)&lt;br&gt;• Governance and onboarding layer, including the collection notice MVP dependency marker&lt;br&gt;• Digital credentials box (issuers, holder wallet, verifiers) (v16)&lt;br&gt;• Eligibility factor verification from program products (v18)&lt;/span&gt;" vertex="1">
          <mxGeometry x="40" y="208" width="1320" height="188" as="geometry" />
        </mxCell>
        <mxCell id="cl2" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DB4D3;fontColor=#222222;align=left;verticalAlign=top;spacing=8;spacingTop=6;spacingLeft=8;" value="&lt;b style=&#39;font-size:15px;color:#003366&#39;&gt;Text tidied (v13 to v15)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:13px&#39;&gt;• &amp;quot;After MVP&amp;quot; text removed throughout: the MVP marker already shows what is in MVP&lt;br&gt;• SDG on the web: &amp;quot;takes over specific id.gov.bc.ca pages&amp;quot; removed&lt;br&gt;• BC Services Card app: &amp;quot;Tech Direction decision&amp;quot; removed&lt;br&gt;• Workflow (hosted n8n) removed from reusable common components; Notify now spans the top row&lt;br&gt;• Service management removed from the bottom layer, now titled Platform and standards&lt;br&gt;• &amp;quot;Not MVP&amp;quot; removed from the trust, permission and transparency cards (delegation and transparency log)&lt;/span&gt;" vertex="1">
          <mxGeometry x="40" y="412" width="1320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cl3" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DB4D3;fontColor=#222222;align=left;verticalAlign=top;spacing=8;spacingTop=6;spacingLeft=8;" value="&lt;b style=&#39;font-size:15px;color:#003366&#39;&gt;Re-laid out&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:13px&#39;&gt;• Trust, permission and transparency now runs the full height beside the experience layer, program products and P2P, matching the sign-in column (v17)&lt;br&gt;• Authoritative data sources is generic: BC Services Card plus other authoritative data sources&lt;/span&gt;" vertex="1">
          <mxGeometry x="40" y="568" width="1320" height="76" as="geometry" />
        </mxCell>
        <mxCell id="cl4" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DB4D3;fontColor=#222222;align=left;verticalAlign=top;spacing=8;spacingTop=6;spacingLeft=8;" value="&lt;b style=&#39;font-size:15px;color:#003366&#39;&gt;MVP markers (v19)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:13px&#39;&gt;• Address Change now carries the MVP marker: SDG and Address Change MVP target is 31 Mar 2027 (team decision; not yet flagged in the dependency matrix)&lt;/span&gt;" vertex="1">
          <mxGeometry x="40" y="660" width="1320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cl5" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9DB4D3;fontColor=#222222;align=left;verticalAlign=top;spacing=8;spacingTop=6;spacingLeft=8;" value="&lt;b style=&#39;font-size:15px;color:#003366&#39;&gt;Still open&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:13px&#39;&gt;• Silent SSO by 1 Feb 2027 · collection notice owner (no longer shown on the diagram)&lt;br&gt;• P2P production readiness · event broker and carriage mechanism for ARD-CS-005&lt;br&gt;• Observability: platform-supported stack or SDG self-hosting · replacement business identity · payments service&lt;/span&gt;" vertex="1">
          <mxGeometry x="40" y="736" width="1320" height="92" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
