{
  "$schema": "https://www.schemastore.org/tsconfig",
  "display": "Browser library — emit .d.ts only (JS comes from vite build)",
  "extends": "./browser-library.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "isolatedDeclarations": true,
    "rootDir": "${configDir}/src",
    "outDir": "${configDir}/dist"
  }
}
