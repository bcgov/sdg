{
  "$schema": "https://www.schemastore.org/tsconfig",
  "display": "NestJS app (ESM) — typecheck",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    // Nest DI relies on decorator metadata, which needs value (not type-only) imports.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": false
  }
}
