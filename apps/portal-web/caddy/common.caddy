# Snippets shared by Caddyfile (production) and Caddyfile.dev (compose). Import inside a site block.

(logging) {
	log {
		output stdout
		format console
		level {$LOG_LEVEL:INFO}
	}
}

(waf) {
	coraza_waf {
		directives `
		Include /etc/caddy/coraza.conf
		`
	}
}

# Proxy /api to an API service. Argument: its upstream URL from the environment. Spread with {args[:]}: an unset
# URL is no argument at all, which leaves the proxy without a target, and Caddy answers 503.
(api_proxy) {
	reverse_proxy /api* {args[:]} {
		header_up Host {http.reverse_proxy.upstream.hostport}
		header_up X-Real-IP {remote_host}
	}
}

# A host that serves only /api (the gateway) answers every other path the way its Nest API answers an unknown route:
# a JSON 404 naming the method and path. Its health and metrics endpoints stay off the edge. The rewrite drops the
# query and makes {uri} the percent-encoded path: Caddy doesn't JSON-escape what it puts in a body, and the encoded
# path holds no quote or backslash, while the decoded path and the raw query can.
(api_only_not_found) {
	@not_api not path /api*
	rewrite @not_api {path}?
	header @not_api Content-Type "application/json; charset=utf-8"
	respond @not_api <<JSON
		{"message":"Cannot {method} {uri}","error":"Not Found","statusCode":404}
		JSON 404
}

# Argument 1: extra script-src sources. Production passes "", Caddyfile.dev passes "'unsafe-inline'"
# for Vite's React Refresh preamble.
# Argument 2: extra style-src sources. Production passes the hashes of react-aria's fixed <style> elements
# (checked by portal-web's csp-hashes.test.ts); the bcgov design system's CSS loads as adopted stylesheets
# (@repo/vite-config adoptedStyleSheets), which style-src doesn't govern. Caddyfile.dev passes "'unsafe-inline'"
# for Vite's injected styles; it must not also get hashes, which make browsers ignore 'unsafe-inline'.
# Caddy leaves a missing argument in place literally, so both are required.
(security_headers) {
	header {
		-Server
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1;mode=block"
		# Default only (?): keeps portal-web's own caching (immutable hashed assets, no-cache HTML).
		?Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		# One line: a newline makes the value invalid, and Go's HTTP/2 server silently drops the whole header.
		Content-Security-Policy "default-src 'self' https://*.gov.bc.ca; script-src 'self' https://*.gov.bc.ca {args[0]}; style-src 'self' https://fonts.googleapis.com https://use.fontawesome.com {args[1]}; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://fonts.googleapis.com https://www.w3.org https://*.gov.bc.ca https://*.tile.openstreetmap.org; frame-ancestors 'self'; form-action 'self'; block-all-mixed-content; connect-src 'self' https://*.gov.bc.ca wss://*.gov.bc.ca;"
		Referrer-Policy "same-origin"
		Permissions-Policy "fullscreen=(self), camera=(), microphone=()"
		Cross-Origin-Resource-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
		# credentialless clears ZAP 90004. require-corp would block no-cors
		# cross-origin assets still allowed by the CSP (fonts, map tiles).
		Cross-Origin-Embedder-Policy "credentialless"
	}
}

# Browser telemetry (Grafana Faro). Site blocks pick one with `import collect_{$TELEMETRY:off}`, so a missing
# TELEMETRY leaves it off. portal-web reads /telemetry.json at startup and only loads Faro when it says enabled.
(collect_off) {
	@telemetry_config path /telemetry.json
	handle @telemetry_config {
		header Cache-Control "no-store"
		header Content-Type "application/json"
		respond `{"enabled":false}` 200
	}
	@collect path /collect /collect/*
	handle @collect {
		respond 204
	}
}

# Needs FARO_COLLECTOR_URL (Alloy's faro.receiver) and TELEMETRY_ENVIRONMENT (pr-<n>, test, prod, local).
(collect_on) {
	@telemetry_config path /telemetry.json
	handle @telemetry_config {
		header Cache-Control "no-store"
		header Content-Type "application/json"
		respond `{"enabled":true,"environment":"{$TELEMETRY_ENVIRONMENT}"}` 200
	}
	@collect path /collect /collect/*
	handle @collect {
		# The endpoint is public (it takes browser telemetry), so cap what one request can send; Alloy rate-limits.
		request_body {
			max_size 64KB
		}
		reverse_proxy {$FARO_COLLECTOR_URL}
	}
}

