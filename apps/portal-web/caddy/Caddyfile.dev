# Local dev (compose.yaml): https://sdg.localhost in front of the Vite dev server and portal-api.
{
	metrics
	# Admin API on localhost only: /load and /config change the live config. Metrics have their own listener.
	admin localhost:2019
	# Unprivileged ports: the image runs as a non-root user. compose.yaml publishes 8443 as the host's 443.
	http_port 8080
	https_port 8443
	order coraza_waf first
	# Certificates come from Caddy's local CA. It can't reach the host trust store from the container;
	# trust the root manually (DEVELOPER.md, Local Stack).
	skip_install_trust
}

import common.caddy

# Prometheus metrics only (the global `metrics` option above); a scraper allowed onto :3003 gets nothing else.
:3003 {
	metrics
}

sdg.localhost {
	tls internal
	import logging

	# Enable Coraza WAF
	import waf

	encode zstd gzip
	import collect_{$TELEMETRY:off}
	import api_proxy
	# Everything else goes to Vite, HMR websocket included. The original Host is kept: Vite allows *.localhost.
	reverse_proxy {$PORTAL_WEB_URL}
	import security_headers "'unsafe-inline'" "'unsafe-inline'"
}

# Grafana from compose.observability.yaml (502 when that override isn't running).
grafana.sdg.localhost {
	tls internal
	import logging
	reverse_proxy {$GRAFANA_URL:http://grafana:3000}
}

# notification-api from compose.yaml, served like production's notify_on (common.caddy): the WAF, /api* (API and
# /api/docs) to notification-api and 404 for the rest (/metrics, /healthz). Admin, owner and credential calls from the
# scripts in apps/notification-api/scripts, and the header's direct-mode preflight, which coraza.conf lets through
# on this host; the portal reaches it inside the network, not through here.
notify.sdg.localhost {
	tls internal
	import logging
	import waf
	import notify_routes {$NOTIFICATION_API_URL:http://notification-api:3000}
}
