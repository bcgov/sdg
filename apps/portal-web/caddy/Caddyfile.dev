# Local dev (compose.yaml): https://sdg.localhost in front of the Vite dev server and portal-api, plus the console and
# gateway hosts. An unset upstream URL leaves its reverse_proxy without a target: Caddy answers 503.
{
	metrics
	# Admin API on localhost only: /load and /config change the live config. Metrics have their own listener.
	admin localhost:2019
	# Unprivileged ports: the image runs as a non-root user. compose.yaml publishes 8443 as the host's 443.
	http_port 8080
	https_port 8443
	# Just inside header, so the waf snippet's header removal wraps the WAF's own responses; the WAF still sees every
	# request before routing, rewrites and proxying.
	order coraza_waf after header
	# Certificates come from Caddy's local CA. It can't reach the host trust store from the container;
	# trust the root manually (DEVELOPER.md, Local Stack).
	skip_install_trust
}

import common.caddy

# Prometheus metrics only (the global `metrics` option above); a scraper allowed onto :3003 gets nothing else.
:3003 {
	metrics
}

sdg.localhost {
	tls internal
	import logging

	# Enable Coraza WAF
	import waf

	encode zstd gzip
	import collect_{$TELEMETRY:off}
	import api_proxy {$PORTAL_API_URL}
	# Everything else goes to Vite, HMR websocket included. The original Host is kept: Vite allows *.localhost.
	reverse_proxy {$PORTAL_WEB_URL}
	import security_headers "'unsafe-inline'" "'unsafe-inline'"
}

# console-web, with /api to console-api.
console.sdg.localhost {
	tls internal
	import logging
	import waf
	encode zstd gzip
	import collect_{$TELEMETRY:off}
	import api_proxy {$CONSOLE_API_URL}
	reverse_proxy {$CONSOLE_WEB_URL}
	import security_headers "'unsafe-inline'" "'unsafe-inline'"
}

# gateway-api's /api only; anything else is a JSON 404 from the edge. No web app, so no Vite allowances.
gateway.sdg.localhost {
	tls internal
	import logging
	import waf
	encode zstd gzip
	import api_proxy {$GATEWAY_API_URL}
	import api_only_not_found
	import security_headers "" ""
}

# Grafana from compose.observability.yaml (502 when that override isn't running).
grafana.sdg.localhost {
	tls internal
	import logging
	reverse_proxy {$GRAFANA_URL:http://grafana:3000}
}
