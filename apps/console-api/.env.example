# console-api environment template. Copy to .env and fill in; .env is gitignored. Validated at boot (src/config/env.ts).
# Optional for the local stack: without it (or without the console client's secret) console-api doesn't start, the console
# host (https://console.sdg.localhost) answers 502, and the portal keeps working.
NODE_ENV=development
PORT=3000
# pino level: fatal | error | warn | info | debug | trace | silent. pino-pretty output when NODE_ENV=development.
LOG_LEVEL=info

# Public origin of console-web; the OIDC redirect URIs are derived from it (<APP_URL>/api/auth/callback, <APP_URL>/), and
# a sign-in core-api refuses (no admin client role) lands on <APP_URL>/not-authorized.
APP_URL=http://localhost:5174
TRUST_PROXY=false

# Local Postgres from the root compose.yaml, as the console login: it owns the console schema, which holds the sessions
# (`pnpm --filter console-api db:migrate` creates them after a build). The domain tables belong to core-api.
DATABASE_URL=postgres://console:console@localhost:5432/portal

# At least 32 characters, e.g. `openssl rand -base64 48`. Signs the cookie and keys the stored session encryption.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800

# Keycloak confidential client for the console (IDIR, with the `admin` client role); not the portal's client.
# core-api's CONSOLE_CLIENT_ID must name the same client.
# The same realm as portal-api and core-api.
KEYCLOAK_ISSUER_URL=https://keycloak.example.com/realms/portal
KEYCLOAK_CLIENT_ID=sdg-console
KEYCLOAK_CLIENT_SECRET=replace-me

# core-api (apps/core-api): sign-in upserts the principal there, and /api/v1/{console,shared}/… is forwarded to it.
# On the host, run core-api on another port than console-api (e.g. PORT=3001 in apps/core-api/.env).
CORE_API_URL=http://localhost:3001

# OpenTelemetry (optional; docs: .mdd/docs/20-observability-lgtm.md). Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to turn
# telemetry off: nothing is loaded. Set it (OTLP/HTTP base URL) to export traces and logs, e.g. http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=console-api
# Comma-separated key=value pairs, e.g. deployment.environment=local
OTEL_RESOURCE_ATTRIBUTES=
# parentbased_traceidratio sampling ratio, 0–1.
OTEL_TRACES_SAMPLER_ARG=1
