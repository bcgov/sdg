# portal-api environment template. Copy to .env and fill in; .env is gitignored. Validated at boot (src/config/env.ts).
NODE_ENV=development
PORT=3000
# pino level: fatal | error | warn | info | debug | trace | silent. pino-pretty output when NODE_ENV=development.
LOG_LEVEL=info

# Public origin of portal-web; the OIDC redirect URIs are derived from it (<APP_URL>/api/auth/callback, <APP_URL>/).
APP_URL=http://localhost:5173
TRUST_PROXY=false

# Local Postgres from the root compose.yaml (also holds sessions).
DATABASE_URL=postgres://portal:portal@localhost:5432/portal

# At least 32 characters, e.g. `openssl rand -base64 48`. Signs the cookie and keys the stored session encryption.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800

# Keycloak confidential client.
KEYCLOAK_ISSUER_URL=https://keycloak.example.com/realms/portal
KEYCLOAK_CLIENT_ID=portal
KEYCLOAK_CLIENT_SECRET=replace-me

# OpenTelemetry (optional; docs: .mdd/docs/20-observability-lgtm.md). Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to turn
# telemetry off: nothing is loaded. Set it (OTLP/HTTP base URL) to export traces and logs, e.g. http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=portal-api
# Comma-separated key=value pairs, e.g. deployment.environment=local
OTEL_RESOURCE_ATTRIBUTES=
# parentbased_traceidratio sampling ratio, 0–1.
OTEL_TRACES_SAMPLER_ARG=1
