# portal-api environment template. Copy to .env and fill in; .env is gitignored. Validated at boot (src/config/env.ts).
NODE_ENV=development
PORT=3000
# pino level: fatal | error | warn | info | debug | trace | silent. pino-pretty output when NODE_ENV=development.
LOG_LEVEL=info

# Public origin of portal-web; the OIDC redirect URIs are derived from it (<APP_URL>/api/auth/callback, <APP_URL>/).
APP_URL=http://localhost:5173
TRUST_PROXY=false

# Local services from the root compose.yaml.
DATABASE_URL=postgres://portal:portal@localhost:5432/portal
VALKEY_URL=redis://localhost:6379

# At least 32 characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800

# Keycloak confidential client.
KEYCLOAK_ISSUER_URL=https://keycloak.example.com/realms/portal
KEYCLOAK_CLIENT_ID=portal
KEYCLOAK_CLIENT_SECRET=replace-me
