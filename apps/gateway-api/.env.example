# gateway-api environment template. Copy to .env and fill in; .env is gitignored. Validated at boot (src/config/env.ts).
# gateway-api holds no secrets, no database and no session: it forwards service accounts' GET /api/v1/gateway/… calls
# with their own Bearer token to core-api, which verifies it.
NODE_ENV=development
PORT=3000
# pino level: fatal | error | warn | info | debug | trace | silent. pino-pretty output when NODE_ENV=development.
LOG_LEVEL=info
TRUST_PROXY=false

# core-api (apps/core-api). On the host, run core-api on another port than gateway-api (e.g. PORT=3001 in
# apps/core-api/.env).
CORE_API_URL=http://localhost:3001

# OpenTelemetry (optional; docs: .mdd/docs/20-observability-lgtm.md). Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to turn
# telemetry off: nothing is loaded. Set it (OTLP/HTTP base URL) to export traces and logs, e.g. http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=gateway-api
# Comma-separated key=value pairs, e.g. deployment.environment=local
OTEL_RESOURCE_ATTRIBUTES=
# parentbased_traceidratio sampling ratio, 0–1.
OTEL_TRACES_SAMPLER_ARG=1
