# notification-api environment template. Copy to .env and fill in; .env is gitignored. Validated at boot (src/config/env.ts).
NODE_ENV=development
PORT=3000
# pino level: fatal | error | warn | info | debug | trace | silent. pino-pretty output when NODE_ENV=development.
LOG_LEVEL=info
TRUST_PROXY=false

# api: API routes, health and metrics. worker: the delivery loops, health and metrics only. all (default): both.
NOTIFICATION_ROLE=all

# Its own `notification` database in the local Postgres from the root compose.yaml.
DATABASE_URL=postgres://portal:portal@localhost:5432/notification

# Keycloak issuer whose access tokens the API accepts (https only).
KEYCLOAK_ISSUER_URL=https://keycloak.example.com/realms/standard
# This service's client id: the audience it accepts on tokens.
NOTIFICATION_CLIENT_ID=notification-api
# Comma-separated client ids allowed to relay a user's token (e.g. portal-api's client).
RELAYING_CLIENT_IDS=portal
# Comma-separated website origins (exact, e.g. https://app.example.gov.bc.ca or http://localhost:5173; no path or
# trailing slash) whose pages may call the recipient endpoints (/api/v1/me/*) directly with a bearer token: the
# header's direct mode. Empty: no CORS headers on any response, so only same-origin and server-side callers work.
CORS_ALLOWED_ORIGINS=

# At least 32 characters, e.g. `openssl rand -base64 48`. Keys the encryption of stored secrets.
NOTIFICATION_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Comma-separated hosts exempt from the outbound guard (local mail catcher, webhook receiver). Empty in real environments.
NOTIFICATION_OUTBOUND_ALLOW_HOSTS=
# Milliseconds a worker waits between polls for due notifications, deliveries and callbacks (default 1000).
NOTIFICATION_WORKER_POLL_MS=1000
# IANA time zone used when a recipient has none.
DEFAULT_TIMEZONE=America/Vancouver
# portal-web's confirm page (https). Email confirmation links open <this>?token=…
CONFIRM_EMAIL_URL=https://sdg.localhost/confirm-email

# Platform-wide default email integration (optional). Leave DEFAULT_SMTP_HOST blank for no default.
DEFAULT_SMTP_HOST=
DEFAULT_SMTP_PORT=
# true: implicit TLS; false: STARTTLS required.
DEFAULT_SMTP_SECURE=
# Set user and password together, or neither. Port defaults to 587.
DEFAULT_SMTP_USER=
DEFAULT_SMTP_PASSWORD=
# A plain address, e.g. notify@example.gov.bc.ca: its domain is the Message-ID's right-hand side.
DEFAULT_SMTP_FROM=

# OpenTelemetry (optional; docs: .mdd/docs/20-observability-lgtm.md). Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to turn
# telemetry off: nothing is loaded. Set it (OTLP/HTTP base URL) to export traces and logs, e.g. http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=notification-api
# Comma-separated key=value pairs, e.g. deployment.environment=local
OTEL_RESOURCE_ATTRIBUTES=
# parentbased_traceidratio sampling ratio, 0–1.
OTEL_TRACES_SAMPLER_ARG=1

# ---- Local scripts only (scripts/login.ts, seed.ts, e2e.ts; see README.md). The app ignores them. ----
# notification-api client's secret, for login.ts. Leave blank for a public client.
NOTIFICATION_CLIENT_SECRET=
# login.ts's callback port: register http://localhost:<port>/callback as a redirect URI on the client.
NOTIFICATION_LOGIN_PORT=8400
# An admin token from `pnpm --filter notification-api --silent admin-token`. Blank: seed and e2e sign in through the browser.
NOTIFICATION_ADMIN_TOKEN=
NOTIFICATION_API_BASE_URL=https://notify.sdg.localhost
# Two Keycloak service-account clients: seed links them as the sender's credentials, e2e gets their tokens.
SENDER_CREDENTIAL_A_CLIENT_ID=
SENDER_CREDENTIAL_A_CLIENT_SECRET=
SENDER_CREDENTIAL_B_CLIENT_ID=
SENDER_CREDENTIAL_B_CLIENT_SECRET=
# e2e: the `portal.sid` cookie's value after signing in at https://sdg.localhost (as the admin), for relayed calls.
PORTAL_SESSION_COOKIE=
PORTAL_URL=https://sdg.localhost
MAILPIT_URL=http://localhost:8025
# The webhook receiver from the host, and as notification-api reaches it inside the compose network.
WEBHOOK_RECEIVER_URL=http://localhost:8090
WEBHOOK_RECEIVER_INTERNAL_URL=http://webhook-receiver:8080
# Runs e2e's second worker in the notification-api container: `podman compose` or `docker compose`.
E2E_COMPOSE="podman compose"
