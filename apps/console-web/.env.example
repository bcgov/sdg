# console-web environment template.
# Vite exposes only VITE_* variables to client code, and they are bundled into public JS: never put secrets here.

# Dev/preview server only (not bundled): where Vite proxies /api. Defaults to http://localhost:3000 (console-api).
# vite.config.ts reads it from the shell environment, not from .env files: export it before `pnpm dev`.
# CONSOLE_API_URL=http://localhost:3000

# Signed-in Playwright specs (e2e/service-clients.spec.ts) run only when both are set: an IDIR test account holding
# the admin client role. Without them those specs are skipped; the signed-out specs always run.
# E2E_CONSOLE_USERNAME=
# E2E_CONSOLE_PASSWORD=
