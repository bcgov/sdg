# core-api environment template. Copy to .env and fill in; .env is gitignored. Validated at boot (src/config/env.ts).
# core-api holds no secrets: it only verifies the Keycloak access tokens the forwarders pass on.
NODE_ENV=development
PORT=3000
# pino level: fatal | error | warn | info | debug | trace | silent. pino-pretty output when NODE_ENV=development.
LOG_LEVEL=info
TRUST_PROXY=false

# Local Postgres from the root compose.yaml, as the core login (it owns the core schema).
DATABASE_URL=postgres://core:core@localhost:5432/portal

# The realm that issues every token core-api accepts.
KEYCLOAK_ISSUER_URL=https://keycloak.example.com/realms/portal
# Person tokens are accepted from these clients (their azp). CONSOLE_CLIENT_ID is optional until console-api exists:
# unset, no console-client token is accepted.
PORTAL_CLIENT_ID=portal
CONSOLE_CLIENT_ID=

# OpenTelemetry (optional; docs: .mdd/docs/20-observability-lgtm.md). Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to turn
# telemetry off: nothing is loaded. Set it (OTLP/HTTP base URL) to export traces and logs, e.g. http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=core-api
# Comma-separated key=value pairs, e.g. deployment.environment=local
OTEL_RESOURCE_ATTRIBUTES=
# parentbased_traceidratio sampling ratio, 0–1.
OTEL_TRACES_SAMPLER_ARG=1
